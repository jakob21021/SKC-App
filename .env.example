# Ohne diese Werte startet die App im Demo-Modus (Daten nur lokal im Browser).
# Mit Supabase-Projekt (Region Frankfurt/EU empfohlen) wird die echte Datenbank genutzt.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Öffentlicher VAPID-Schlüssel für Push-Benachrichtigungen (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
