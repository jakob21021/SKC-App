{
  "name": "skc-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vereins-App des Schweriner Korfball Club e. V. '67",
  "scripts": {
    "dev": "vite",
    "lokal": "node scripts/local.mjs",
    "lokal:stop": "supabase stop",
    "lokal:reset": "supabase db reset",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash supabase/tests/run.sh",
    "test:api": "bash supabase/tests/integration.sh",
    "test:e2e": "vite build && node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:sql": "tsx scripts/demo-sql.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
